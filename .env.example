# CyberShield AI Environment Configuration
# Copy this file to .env and update with your values

# =============================================
# APPLICATION SETTINGS
# =============================================
APP_NAME=CyberShield AI
APP_VERSION=1.0.0
APP_ENV=production
DEBUG=false

# =============================================
# SERVER CONFIGURATION
# =============================================
HOST=0.0.0.0
PORT=8001
WORKERS=4

# =============================================
# DATABASE CONFIGURATION
# =============================================
# MongoDB Connection
MONGODB_URI=mongodb://admin:securepassword123@mongodb:27017/cybershield?authSource=admin
DATABASE_URL=mongodb://mongodb:27017/cybershield

# MongoDB Credentials
MONGO_USERNAME=admin
MONGO_PASSWORD=securepassword123
MONGO_DATABASE=cybershield

# =============================================
# REDIS CONFIGURATION
# =============================================
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=redissecurepassword123

# =============================================
# JWT CONFIGURATION
# =============================================
# Generate a secure JWT secret for production!
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=7

# =============================================
# SECURITY SETTINGS
# =============================================
# Password requirements
MIN_PASSWORD_LENGTH=8
REQUIRE_UPPERCASE=true
REQUIRE_LOWERCASE=true
REQUIRE_NUMBERS=true
REQUIRE_SPECIAL=true

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# CORS settings
CORS_ORIGINS=http://localhost:3000,http://localhost:80,https://your-domain.com
CORS_ALLOW_CREDENTIALS=true

# =============================================
# AI MODELS CONFIGURATION
# =============================================
# Fake News Detection
FAKE_NEWS_MODEL_NAME=distilbert-base-uncased-finetuned-sst-2-english
FAKE_NEWS_MODEL_PATH=./models/fake_news
ENABLE_GPU=false

# Deepfake Detection
DEEPFAKE_MODEL_PATH=./models/deepfake
OPENCV_THREADS=4

# Crime Prediction
CRIME_MODEL_PATH=./models/crime
HISTORICAL_DATA_PATH=./data/crime_historical.csv

# =============================================
# FILE UPLOAD SETTINGS
# =============================================
MAX_FILE_SIZE_VIDEO=104857600  # 100MB in bytes
MAX_FILE_SIZE_IMAGE=10485760   # 10MB in bytes
ALLOWED_VIDEO_FORMATS=mp4,mov,avi,webm,mkv
ALLOWED_IMAGE_FORMATS=jpg,jpeg,png,webp,gif,bmp

# Upload directory
UPLOAD_DIR=./uploads
TEMP_DIR=./temp

# =============================================
# EMAIL CONFIGURATION (for 2FA and notifications)
# =============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@cybershield.ai
SMTP_FROM_NAME=CyberShield AI
SMTP_USE_TLS=true

# =============================================
# SMS CONFIGURATION (for 2FA - optional)
# =============================================
# Twilio Configuration
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# =============================================
# MONITORING & LOGGING
# =============================================
# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
LOG_ROTATION=true
LOG_MAX_SIZE=10485760  # 10MB
LOG_BACKUP_COUNT=5

# Monitoring
ENABLE_PROMETHEUS=true
PROMETHEUS_PORT=9090
ENABLE_GRAFANA=true
GRAFANA_PORT=3001

# Health check
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10

# =============================================
# SSL/HTTPS CONFIGURATION
# =============================================
SSL_ENABLED=false
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# =============================================
# BACKUP CONFIGURATION
# =============================================
# Database backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=7
BACKUP_DIR=./backups

# =============================================
# DEVELOPMENT SETTINGS
# =============================================
# Only for development environment
DEV_MODE=false
DEV_MONGODB_URI=mongodb://localhost:27017/cybershield
DEV_REDIS_URL=redis://localhost:6379

# =============================================
# FEATURES FLAGS
# =============================================
ENABLE_2FA=true
ENABLE_API_KEYS=true
ENABLE_PASSWORD_RESET=true
ENABLE_RATE_LIMITING=true
ENABLE_CACHING=true
ENABLE_ANALYTICS=true

# =============================================
# PERFORMANCE SETTINGS
# =============================================
# Connection pooling
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Request handling
MAX_REQUEST_SIZE=104857600  # 100MB
REQUEST_TIMEOUT=300
KEEPALIVE_TIMEOUT=65

# =============================================
# API LIMITS
# =============================================
API_RATE_LIMIT_PER_MINUTE=60
API_RATE_LIMIT_PER_HOUR=1000
API_BURST_LIMIT=20

# =============================================
# SESSION SETTINGS
# =============================================
SESSION_SECRET=your-session-secret-change-this-in-production
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=strict
SESSION_MAX_AGE=86400  # 24 hours

# =============================================
# DOMAIN CONFIGURATION
# =============================================
DOMAIN=localhost
BASE_URL=http://localhost
FRONTEND_URL=http://localhost
BACKEND_URL=http://localhost:8001

# =============================================
# NOTIFICATION SETTINGS
# =============================================
NOTIFICATION_ENABLED=true
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_SMS_ENABLED=false
NOTIFICATION_WEBHOOK_ENABLED=false
NOTIFICATION_WEBHOOK_URL=

# =============================================
# DATA RETENTION
# =============================================
ANALYSIS_RETENTION_DAYS=90
ALERT_RETENTION_DAYS=180
LOG_RETENTION_DAYS=30
ACTIVITY_LOG_RETENTION_DAYS=60

# =============================================
# MAINTENANCE MODE
# =============================================
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="System under maintenance. Please try again later."

# =============================================
# THIRD-PARTY INTEGRATIONS
# =============================================
# Google Analytics (optional)
GOOGLE_ANALYTICS_ID=

# Sentry (error tracking)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# =============================================
# CUSTOM SETTINGS
# =============================================
# Add any custom settings here
CUSTOM_SETTING_1=
CUSTOM_SETTING_2=