# AWS Deployment - Files to Exclude
# This reduces upload size from 500MB+ to ~50MB

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv

# Node modules
node_modules/
npm-debug.log
yarn-error.log

# Build outputs
backend/build/
frontend/build/
frontend/dist/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Temporary files
temp/
tmp/
*.tmp

# Database
*.db
*.sqlite
*.sqlite3

# Development
.env.local
.env.development
*.dev

# Git
.git/
.gitignore

# Documentation (not needed for deployment)
*.md
docs/

# Test files
test_*.py
*_test.py
tests/

# Windows
backend/venv/
frontend/node_modules/

# Dependencies (server will install these)
backend/*cpython-313*.pyd
backend/*cpython-313*.so
backend/*cp310-win_amd64.pyd
backend/*cp311-win_amd64.pyd
backend/*cp312-win_amd64.pyd
backend/*cp313-win_amd64.pyd
backend/*cp39-win_amd64.pyd

# Package cache
frontend/.cache/
frontend/package-lock.json